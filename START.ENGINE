                    "container-max": "1280px",
                    "gutter": "24px",
                    "stack-sm": "8px",
                    "margin-desktop": "64px",
                    "margin-mobile": "20px",
                    "stack-md": "16px"
            },
            "fontFamily": {
                    "headline-md": ["Sora"],
                    "data-mono": ["IBM Plex Sans"],
                    "body-md": ["IBM Plex Sans"],
