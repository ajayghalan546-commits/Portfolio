                    "secondary-container": "#af8d11",
                    "on-secondary-container": "#342800",
                    "on-tertiary-fixed": "#191b23",
                    "secondary": "#e9c349",
                    "on-primary": "#003907",
                    "on-error": "#690005"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
