<style>
        body {
            background-color: #0b0e14;
            color: #e1e2eb;
            overflow-x: hidden;
        }
        .glass-card {
            background: rgba(16, 19, 26, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card:hover {
            border-color: #00e639;
            box-shadow: 0 0 30px rgba(0, 230, 57, 0.05);
        }
        .glowing-trace {
            background: linear-gradient(180deg, rgba(0, 230, 57, 0.15) 0%, rgba(0, 230, 57, 0) 100%);
        }
        .hero-pattern {
            background-image: radial-gradient(circle at 2px 2px, rgba(0, 230, 57, 0.05) 1px, transparent 0);
            background-size: 40px 40px;
            animation: grid-pulse 8s ease-in-out infinite;
        }

        @keyframes grid-pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        /* Sophisticated Entrance Animations */
        .animate-fade-in-up {
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Shimmer Effect for Headline */
        .headline-shimmer {
            position: relative;
            overflow: hidden;
        }
        .headline-shimmer::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            animation: shimmer 4s infinite 1s;
        }
        @keyframes shimmer {
            0% { left: -100%; }
            30% { left: 150%; }
            100% { left: 150%; }
        }

        /* Glitch Effect for Badge */
        .glitch-text {
            animation: glitch 5s infinite;
        }
        @keyframes glitch {
            0%, 90%, 100% { opacity: 1; transform: skew(0); }
            91% { opacity: 0.8; transform: skew(2deg); filter: contrast(1.5); }
            92% { opacity: 1; transform: skew(-1deg); }
            93% { opacity: 0.7; transform: skew(1deg); }
            94% { opacity: 1; transform: skew(0); }
        }

        /* Ambient Float for Visualization */
        .float-visual {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translateY(-50%) translateX(0px); }
            50% { transform: translateY(-55%) translateX(-10px); }
        }

        /* Enhanced Button Pulse & Glow */
        .btn-pulse-glow {
            box-shadow: 0 0 0 0 rgba(0, 230, 57, 0);
            animation: subtle-pulse 4s infinite;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-pulse-glow:hover {
            box-shadow: 0 0 30px 5px rgba(0, 230, 57, 0.4);
            transform: translateY(-2px);
        }
        @keyframes subtle-pulse {
            0% { box-shadow: 0 0 0 0 rgba(0, 230, 57, 0.1); }
            70% { box-shadow: 0 0 0 15px rgba(0, 230, 57, 0); }
            100% { box-shadow: 0 0 0 0 rgba(0, 230, 57, 0); }
        }
    </style>
</head>
<body class="font-body-md selection:bg-primary-fixed-dim selection:text-on-primary">
